{
  // Shared compiler face. TypeScript 7 turns `strict`, `module: esnext` and
  // `noUncheckedSideEffectImports` on by default and defaults `types` to `[]`;
  // the options restated here are the ones we tighten beyond those defaults or
  // that the emit layout depends on.
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "isolatedModules": true,
    // Local relative imports carry `.ts`, matching the harness convention;
    // the compiler rewrites them on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "erasableSyntaxOnly": false,
    "skipLibCheck": true
  }
}
