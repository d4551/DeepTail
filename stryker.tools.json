{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "commandRunner": {
    "command": "bun test tests/actions.spec.ts tests/jsonc.spec.ts tests/stack.spec.ts tests/stack-policy.spec.ts tests/outdated-gate.spec.ts tests/compiler-face.spec.ts tests/cargo-gate.spec.ts tests/mutate-restore.spec.ts tests/entry-gate.spec.ts tests/gate-runner.spec.ts tests/gate-declarations.spec.ts tests/registry-readers.spec.ts tests/pins.spec.ts"
  },
  "mutate": [
    "scripts/action-registry-emit.ts",
    "scripts/action-registry-rust.ts",
    "scripts/action-registry.ts",
    "scripts/cargo-freshness.ts",
    "scripts/check-bans.ts",
    "scripts/check-entries.ts",
    "scripts/check-no-inline-styles.ts",
    "scripts/check-outdated.ts",
    "scripts/check-stylesheets.ts",
    "scripts/check-tree.ts",
    "scripts/compiler-face.ts",
    "scripts/entry-gate.ts",
    "scripts/gate-runner.ts",
    "scripts/gen-action-registry.ts",
    "scripts/jsonc.ts",
    "scripts/mutate-restore.ts",
    "scripts/mutation-survivors.ts",
    "scripts/pins.ts",
    "scripts/registry-readers.ts"
  ],
  "coverageAnalysis": "off",
  "disableTypeChecks": false,
  "thresholds": {
    "high": 99,
    "low": 99,
    "break": 99
  },
  "reporters": ["progress", "clear-text", "json"],
  "timeoutMS": 60000,
  "concurrency": 4,
  "inPlace": true
}
