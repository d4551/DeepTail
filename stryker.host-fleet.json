{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "commandRunner": {
    "command": "bun test packages/host-fleet/tests"
  },
  "mutate": ["packages/host-fleet/src/**/*.ts"],
  "coverageAnalysis": "off",
  "disableTypeChecks": false,
  "thresholds": {
    "high": 99,
    "low": 99,
    "break": 99
  },
  "reporters": ["progress", "clear-text", "json"],
  "timeoutMS": 60000,
  "concurrency": 4,
  "inPlace": true
}
