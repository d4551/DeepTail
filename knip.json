{
  "$schema": "https://unjs.io/schema/knip.json",
  "workspaces": {
    "packages/host-fleet": {
      "project": ["src/**/*.ts"]
    },
    "apps/deeptail": {
      "entry": ["tests/*.spec.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    ".": {
      "entry": ["scripts/*.ts", "tests/*.spec.ts"],
      "project": ["scripts/**/*.ts", "tests/**/*.ts"]
    }
  }
}
